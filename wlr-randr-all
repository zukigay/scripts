#!/usr/bin/env python3
import subprocess
import json
import sys

def list_to_str(l):
    res = ""
    for x in range(0,len(l)):
        res += l[x]
        if x != len(l):
            res += " "
    return res



def main():
    if len(sys.argv) < 2:
        sys.stderr.write("Not enough args.\n")
        exit()

    wlr_raw = subprocess.check_output(["wlr-randr","--json"])
    wlr = json.loads(wlr_raw)
    # print(wlr)
    # print("--- spacing ---")
    for output in wlr:
        command = ["wlr-randr","--output",output["name"],*sys.argv[1:]]
        # print(command)
        subprocess.run(command)

if __name__ == "__main__":
    main()
