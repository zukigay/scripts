#!/usr/bin/env bash
cd ~/Games
while [ true ]; do 
    fuzzel_g="$(ls "$PWD" | fuzzel -d)"
    if [ -z "$fuzzel_g" ] ; then
        break
    fi
    if [ -d "$fuzzel_g" ] ; then
        cd "$fuzzel_g"
    elif [[ $fuzzel_g == *.exe ]] ; then
        exec wine "./$fuzzel_g"
    # TODO consider improving this code by also adding stuff for handling tar files etc
    elif [[ $fuzzel_g == *.zip ]] ; then
        # TODO consider diffrent name then both
        prompt="$(printf "yes\nno\ndelete\nboth" | fuzzel -d -p "would you like to unzip $fuzzel_g?")"
        if [ "$prompt" == "yes" ] ; then
            unzip -n "$fuzzel_g" && notify-send -u low "unzipped" "$fuzzel_g"
        elif [ "$prompt" == "both" ] ; then
            unzip -n "$fuzzel_g"
            error_code="$?"
            if [ "$error_code" == 0 ] ; then
                notify-send -u low "unzipped" "$fuzzel_g"
                rm "$fuzzel_g"
            fi
        elif [ "$prompt" == "delete" ] ; then
            rm "$fuzzel_g"
        fi
    elif [ -x "$fuzzel_g" ] ; then
        exec "./$fuzzel_g"
    fi
done
